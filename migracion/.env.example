# Copia este archivo como .env (no se sube al repositorio). Bórralo al terminar la migración.

# ---- Base NUEVA (Horus) ----
NUEVO_URL=https://TU-PROYECTO-NUEVO.supabase.co
# Clave SECRETA (Project Settings → API → service_role / secret). Solo para este script, nunca en la web.
NUEVO_SERVICE_KEY=

# ---- Bases ANTIGUAS (solo lectura) ----
# La URL y la clave publicable se leen solas de legado/*/config.js; si no tienes esa carpeta, escríbelas aquí.
# Un usuario de cada app. Lo que dejes vacío se omite (para migrar solo equipos, deja vacíos Inventario y Lafken).
EQUIPOS_URL=
EQUIPOS_KEY=
EQUIPOS_EMAIL=
EQUIPOS_PASS=
INVENTARIO_EMAIL=
INVENTARIO_PASS=
# En Lafken conviene un usuario administrador (así también lista los usuarios a recrear)
LAFKEN_EMAIL=
LAFKEN_PASS=
