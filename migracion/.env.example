# Copia este archivo como .env (no se sube al repositorio). Bórralo al terminar la migración.

# ---- Base NUEVA (Horus) ----
NUEVO_URL=https://TU-PROYECTO-NUEVO.supabase.co
# Clave SECRETA (Project Settings → API → service_role / secret). Solo para este script, nunca en la web.
NUEVO_SERVICE_KEY=

# ---- Bases ANTIGUAS (solo lectura) ----
# La URL y la clave se leen solas de legado/*/config.js. Solo falta un usuario de cada app:
EQUIPOS_EMAIL=
EQUIPOS_PASS=
INVENTARIO_EMAIL=
INVENTARIO_PASS=
# En Lafken conviene un usuario administrador (así también lista los usuarios a recrear)
LAFKEN_EMAIL=
LAFKEN_PASS=
